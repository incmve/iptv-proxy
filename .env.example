# Copy this file to .env and fill in your values. Never commit .env.

# ── IPTV provider ────────────────────────────────────────────────────────────
# M3U or Xtream URL (credentials embedded in the URL are fine here)
M3U_URL=http://your-provider:8000/get.php?username=USER&password=PASS&type=m3u_plus&output=mpegts

# ── Proxy credentials (what clients use to connect to THIS proxy) ─────────────
PROXY_USER=
PROXY_PASSWORD=

# ── Network ───────────────────────────────────────────────────────────────────
PORT=8080
HOSTNAME=localhost

# ── Gluetun / ProtonVPN (production only) ────────────────────────────────────
OPENVPN_USER=
OPENVPN_PASSWORD=

# ── Gin ───────────────────────────────────────────────────────────────────────
# Use "debug" locally, "release" in production
GIN_MODE=release

# ── Stream buffering (smooths out network jitter on live channels) ────────────
BUFFER_ENABLED=false
BUFFER_DURATION=5
BUFFER_MAX_MEMORY=10
BUFFER_PRELOAD=3
