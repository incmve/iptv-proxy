# Copy this file to .env and fill in your values. Never commit .env.

# ── IPTV provider ────────────────────────────────────────────────────────────
# Xtream get.php URL; provider URL, username and password are taken from it.
M3U_URL=http://your-provider:8000/get.php?username=USER&password=PASS&type=m3u_plus&output=mpegts
# Or set all three explicitly instead (then M3U_URL is not needed):
# XTREAM_BASE_URL=http://your-provider:8000
# XTREAM_USER=
# XTREAM_PASSWORD=

# User-Agent for the proxy's own provider API calls. Streams forward the
# player's User-Agent. Default "iptv-proxy" (what the Go version sent).
# PROVIDER_USER_AGENT=iptv-proxy

# ── Proxy credentials (what clients use to connect to THIS proxy) ─────────────
PROXY_USER=
PROXY_PASSWORD=

# ── Network ──────────────────────────────────────────────────────────────────
# HOSTNAME / ADVERTISED_PORT are written into playlist and login answers, so
# they must be what your players can reach.
HOSTNAME=iptvproxy
# ADVERTISED_PORT=           # default: same as PORT
# HTTPS=false                # write https:// URLs (when behind a TLS reverse proxy)

# ── Playlists ────────────────────────────────────────────────────────────────
# M3U_CACHE_EXPIRATION=1     # hours to cache get.php
# M3U_FILE_NAME=iptv.m3u

# ── Live ─────────────────────────────────────────────────────────────────────
# Players on the same live channel share one provider connection.
# SHARE_LIVE_STREAMS=true

# ── EPG / cache ──────────────────────────────────────────────────────────────
# XMLTV_CACHE_MINUTES=60     # 0 = no cache
# CACHE_DIR=/cache           # default: system temp dir

# ── VOD ──────────────────────────────────────────────────────────────────────
# Cap per movie/series stream in kbit/s after a 4 s burst. 0 = off.
# VOD_THROTTLE_KBPS=0

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=info             # error, warn, info, debug, trace

# ── Gluetun VPN ──────────────────────────────────────────────────────────────
VPN_USER=
VPN_PASS=
