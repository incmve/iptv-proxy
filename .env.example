# Copy this file to .env and fill in your values. Never commit .env.

# Gluetun / ProtonVPN credentials
OPENVPN_USER=
OPENVPN_PASSWORD=

# IPTV provider M3U or Xtream URL (credentials embedded in the URL are fine here)
M3U_URL=http://your-provider:8000/get.php?username=USER&password=PASS&type=m3u_plus&output=mpegts

# Credentials clients use to connect to THIS proxy
PROXY_USER=
PROXY_PASSWORD=

# Stream buffering (smooths out network jitter on live channels)
# BUFFER_ENABLED=true
# BUFFER_DURATION=5      # seconds to buffer
# BUFFER_MAX_MEMORY=10   # MB per stream
# BUFFER_PRELOAD=3       # seconds to pre-buffer before playback starts
